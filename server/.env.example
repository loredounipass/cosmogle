# Server environment variables — EXAMPLE
# Copy this to .env and fill in real values
PORT=8000

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Comma-separated allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173

# TURN server credentials
# IMPORTANTE: Abre los puertos UDP/TCP 3478 y UDP 49152-65535 en tu router/firewall
TURN_URL=turn:your-turn-server.example.com:80
TURN_USERNAME=your_username
TURN_SECRET=your_secret
TURN_REALM=your-credential.local


# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Logging configuration
LOG_LEVEL=INFO
LOG_COLORS=true
LOG_JSON=false

# NODE_ENV=production
NODE_ENV=production